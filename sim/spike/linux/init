#!/bin/sh
set -eu
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
fail() { echo "GLANDA-DT-FAIL: $*"; exec /bin/sh -i; }
uname -a
node=/sys/firmware/devicetree/base/soc/gpu@40000000
[ -d "$node" ] || fail 'missing live OF node'
compat=$(tr -d '\000' <"$node/compatible")
reg=$(od -An -tx1 -v "$node/reg" | tr -d ' \n')
echo "OF: /soc/gpu@40000000 compatible=$compat reg=$reg"
[ "$compat" = glanda,gpu ] || fail compatible
[ "$reg" = 00000000400000000000000000201000 ] || fail reg
for dev in /sys/bus/platform/devices/*; do
    [ "$(readlink -f "$dev/of_node")" = "$(readlink -f "$node")" ] || continue
    echo "platform: ${dev##*/} modalias=$(cat "$dev/modalias")"
    if [ -f /glanda_drm.ko ]; then
        insmod /glanda_drm.ko || fail insmod
        [ -L "$dev/driver" ] && [ -c /dev/dri/card0 ] || fail 'missing bound DRM card'
        echo "DRM: $(readlink -f "$dev/driver") -> /dev/dri/card0"
        case " $(cat /proc/cmdline) " in
            *' glanda.kmstest=1 '*) /bin/kms-test || fail 'DRM ioctl test failed';;
        esac
        echo 'Run kms-test for the test pattern or poweroff -f to shut down.'
        exec /bin/sh -i
    fi
    [ ! -L "$dev/driver" ] || fail 'unexpected driver binding'
    echo 'driver: unbound (expected)'
    echo 'GLANDA-DT-PASS'
    echo 'BusyBox guest shell; try: ls /sys/bus/platform/devices'
    exec /bin/sh -i
done
fail 'no platform device points to this OF node'
